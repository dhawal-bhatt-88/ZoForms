// Prisma schema — the six core tables for the walking skeleton.
// Grow this from tally-teardown.html §11 (Database Design) as features land.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum FormStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  name          String?
  passwordHash  String?
  isAdmin       Boolean       @default(false)
  emailVerified Boolean       @default(false)
  status        String        @default("active") // active | suspended
  createdAt     DateTime      @default(now())
  memberships   Membership[]
  emailTokens   EmailToken[]
}

model EmailToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String   @unique
  type      String   @default("verify") // verify | reset
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Organization {
  id              String       @id @default(uuid())
  name            String
  slug            String       @unique
  status           String      @default("active") // active | suspended
  createdAt        DateTime    @default(now())
  dataRegion       String     @default("us") // us | eu — data residency label
  retentionDays    Int        @default(0) // 0 = keep responses forever
  brandingHidden   Boolean    @default(false) // white-label: hide "Made with Frame"
  anthropicApiKey String?
  aiModel         String?
  workspaces      Workspace[]
  memberships     Membership[]
  invites         Invite[]
  domains         Domain[]
}

model Domain {
  id           String       @id @default(uuid())
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId        String
  hostname     String       @unique
  status       String       @default("pending") // pending | active | error
  cfHostnameId String?
  lastError    String?
  verifiedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([orgId])
}

model Invite {
  id          String       @id @default(uuid())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId       String
  email       String
  role        Role         @default(EDITOR)
  token       String       @unique
  status      String       @default("pending") // pending | accepted | revoked
  invitedById String?
  createdAt   DateTime     @default(now())
  acceptedAt  DateTime?
  expiresAt   DateTime

  @@unique([orgId, email])
  @@index([orgId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String // admin user id
  actorEmail String
  action     String // e.g. org.suspended, user.suspended, user.impersonated
  targetType String? // org | user | form
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Membership {
  id        String       @id @default(uuid())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      Role         @default(EDITOR)
  createdAt DateTime     @default(now())

  @@unique([orgId, userId])
}

model Workspace {
  id        String       @id @default(uuid())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String
  name      String
  createdAt DateTime     @default(now())
  forms     Form[]
}

model Form {
  id          String        @id @default(uuid())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  title       String
  slug        String        @unique
  status      FormStatus    @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  versions    FormVersion[]
  responses   Response[]
  automations Automation[]
  events      Event[]
}

model Event {
  id        String   @id @default(uuid())
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId    String
  type      String // "view" | "start"
  device    String? // mobile | tablet | desktop
  source    String? // referrer host or "direct"
  createdAt DateTime @default(now())

  @@index([formId, type, createdAt])
}

model Automation {
  id          String    @id @default(uuid())
  form        Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId      String
  name        String
  trigger     String    @default("new_response")
  action      String    @default("webhook")
  config      Json      // { url } for webhook
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  lastFiredAt DateTime?
  lastStatus  String?

  @@index([formId])
}

model FormVersion {
  id        String   @id @default(uuid())
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId    String
  // Append-only: every Save inserts a new row and no row is updated after
  // insert. A form's current version is the one with the highest `version`.
  version   Int
  schema    Json
  label     String?
  createdAt DateTime @default(now())

  // Also stops two concurrent saves from both claiming the next number.
  @@unique([formId, version])
}

model Response {
  id          String    @id @default(uuid())
  form        Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId      String
  data        Json
  meta        Json?
  partial     Boolean   @default(false)
  sessionId   String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@unique([formId, sessionId])
  @@index([formId, createdAt])
  @@index([formId, partial])
}
