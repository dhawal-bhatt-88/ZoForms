// Prisma schema — the six core tables for the walking skeleton.
// Grow this from tally-teardown.html §11 (Database Design) as features land.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  name              String?
  passwordHash      String?
  isAdmin           Boolean      @default(false)
  emailVerified     Boolean      @default(false)
  status            String       @default("active") // active | suspended
  createdAt         DateTime     @default(now())
  // The form editor's settings pane width in px, as the author last left it; null = the default.
  settingsPaneWidth Int?
  memberships       Membership[]
  emailTokens       EmailToken[]
}

model EmailToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String   @unique
  type      String   @default("verify") // verify | reset
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Organization {
  id              String       @id @default(uuid())
  name            String
  slug            String       @unique
  status           String      @default("active") // active | suspended
  createdAt        DateTime    @default(now())
  anthropicApiKey String?
  aiModel         String?
  workspaces      Workspace[]
  memberships     Membership[]
  invites         Invite[]
  domains         Domain[]
  templates       Template[]
}

model Domain {
  id           String       @id @default(uuid())
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId        String
  hostname     String       @unique
  status       String       @default("pending") // pending | active | error
  cfHostnameId String?
  lastError    String?
  verifiedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([orgId])
}

model Invite {
  id          String       @id @default(uuid())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId       String
  email       String
  role        Role         @default(EDITOR)
  token       String       @unique
  status      String       @default("pending") // pending | accepted | revoked
  invitedById String?
  createdAt   DateTime     @default(now())
  acceptedAt  DateTime?
  expiresAt   DateTime

  @@unique([orgId, email])
  @@index([orgId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String // admin user id
  actorEmail String
  action     String // e.g. org.suspended, user.suspended, user.impersonated
  targetType String? // org | user | form
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Membership {
  id        String       @id @default(uuid())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      Role         @default(EDITOR)
  createdAt DateTime     @default(now())

  @@unique([orgId, userId])
}

model Workspace {
  id        String       @id @default(uuid())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId     String
  name      String
  createdAt DateTime     @default(now())
  forms     Form[]
}

model Form {
  id          String        @id @default(uuid())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  title       String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  versions    FormVersion[]
}

// A form or group template. Copied into forms on use, never linked: editing or
// deleting a template never changes a form made from it.
model Template {
  id          String        @id @default(uuid())
  // Null for a system template: made by us from prisma/templates/*.json, seen
  // by every organisation, never written through the app.
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId       String?
  kind        String // form | group
  name        String
  description String?
  // A FormSchema for a form template; one group block for a group template.
  content     Json
  // +1 on every save that changes the content; renames don't count.
  version     Int           @default(1)
  createdBy   String? // user id; not a relation, so deleting a user keeps the template
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orgId, kind])
}

model FormVersion {
  id        String   @id @default(uuid())
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId    String
  // Append-only: every Save inserts a new row and no row is updated after
  // insert. A form's current version is the one with the highest `version`.
  version   Int
  schema    Json
  label     String?
  createdAt DateTime @default(now())

  // Also stops two concurrent saves from both claiming the next number.
  @@unique([formId, version])
}
