    "blocks": [
      {
        "id": "email",
        "type": "email",
        "label": "Email",
        "required": true
      },
      {
        "id": "topics",
        "type": "checkbox",
        "label": "What are you interested in?",
        "required": false,
        "options": [
          {
            "code": "product",
            "label": "Product"
          },
          {
            "code": "engineering",
            "label": "Engineering"
          },
          {
            "code": "design",
            "label": "Design"
          },
          {
            "code": "company_news",
            "label": "Company news"
          }
        ]
      }
    ]
  }
}
