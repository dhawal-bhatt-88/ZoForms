{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2021",
    "lib": ["ES2021"],
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "outDir": "./dist",
    "baseUrl": "./",
    // @zoworkhq/forms publishes /core through `exports`, which "node" resolution can't read.
    "paths": { "@zoworkhq/forms/core": ["node_modules/@zoworkhq/forms/dist/core/index.d.ts"] }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
