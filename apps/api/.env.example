# Local Postgres from docker-compose (root)
DATABASE_URL="postgresql://postgres:dev@localhost:5432/formbuilder?schema=public"
PORT=4000

# development (default), test or production. Production refuses a missing, example
# or short (under 32 characters) JWT_SECRET.
# NODE_ENV=development

# Public origin of the API, allowed by CORS (set to your API origin in prod)
PUBLIC_API_URL="http://localhost:4000"

# Public origin of the web app, allowed by CORS and used in invite, verification
# and password-reset links (default http://localhost:3000)
PUBLIC_TENANT_URL="http://localhost:3000"

# Extra origins allowed by CORS, comma-separated. Localhost, the API's own host
# and the hosts of the two origins above are always allowed.
# CORS_ORIGINS=https://admin.example.com

# Secret used to sign auth JWTs (use a long random string in prod)
JWT_SECRET="dev-secret-change-me"

# Optional: transactional email through Resend (invites, verification, password
# reset). Without a key, emails are logged and not sent, so password accounts
# can't verify, invite or reset.
# RESEND_API_KEY=re_...
# MAIL_FROM="Zowork Forms <onboarding@resend.dev>"

# Optional: Google sign-in. The OAuth client id; set the web app's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID to the same value. Without it, Google sign-in is off.
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Test only: put verification and password-reset links in API responses, so a
# flow can be followed without an inbox. Refused in production.
# RETURN_EMAIL_LINKS_FOR_TESTS=true
