# Local Postgres from docker-compose (root)
DATABASE_URL="postgresql://postgres:dev@localhost:5432/formbuilder?schema=public"
PORT=4000

# Base URL used to build public file-upload links (set to your API origin in prod)
PUBLIC_API_URL="http://localhost:4000"

# Secret used to sign auth JWTs (use a long random string in prod)
JWT_SECRET="dev-secret-change-me"
