NEXT_PUBLIC_API_URL=http://localhost:4000

# The web app's own public address: the base of Open Graph and canonical URLs
# on the public pages. Read at build time. Defaults to http://localhost:3000.
# NEXT_PUBLIC_WEB_URL=https://forms.example.com

# Optional: Google sign-in. The same OAuth client id as the API's GOOGLE_CLIENT_ID;
# without it the Google button is hidden.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
