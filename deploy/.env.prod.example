# Copy to ~/frame/.env.prod on the EC2 host and fill in real values.
# This file lives ONLY on the server — never commit the real .env.prod.

# --- Postgres (runs in a container on this box) ---
POSTGRES_USER=frame
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=formbuilder

# --- API ---
# Long random string used to sign auth JWTs. (Must NOT be the dev default.)
JWT_SECRET=change-me-to-a-long-random-string
# Public origin of the API (allowed by CORS).
# Use your EC2 public IP or domain, e.g. http://203.0.113.10:4000
PUBLIC_API_URL=http://YOUR_EC2_PUBLIC_IP:4000
# Public origin of the tenant web app — used for invite and email-verify
# links, e.g. http://203.0.113.10:3000
PUBLIC_TENANT_URL=http://YOUR_EC2_PUBLIC_IP:3000

# --- Optional integrations (every feature works without them; set to enable) ---
# AI (Claude): real generation / summaries / translation
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Transactional email (invites, verification, password reset)
# RESEND_API_KEY=re_...
# MAIL_FROM=Frame <noreply@yourdomain.com>
# Google sign-in — the OAuth client id (same value both places).
# The API verifies ID tokens against it; the web bakes it in at build time.
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
#   ...and set repo Variable NEXT_PUBLIC_GOOGLE_CLIENT_ID to the same value.
# Response search (Meilisearch)
# MEILI_HOST=http://meili:7700
# MEILI_KEY=...
# Custom domains (Cloudflare SSL-for-SaaS)
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ZONE_ID=...
# DOMAIN_CNAME_TARGET=cname.yourdomain.com

# --- Image refs ---
# Normally injected by the Deploy workflow (pinned to the commit SHA).
# Set them here only if you run `docker compose` on the box by hand.
# IMAGE_API=ghcr.io/OWNER/REPO-api:latest
# IMAGE_WEB=ghcr.io/OWNER/REPO-web:latest
# IMAGE_ADMIN=ghcr.io/OWNER/REPO-admin:latest
