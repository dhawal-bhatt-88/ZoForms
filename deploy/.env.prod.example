# Copy to ~/frame/.env.prod on the EC2 host and fill in real values.
# This file lives ONLY on the server — never commit the real .env.prod.

# --- Postgres (runs in a container on this box) ---
POSTGRES_USER=frame
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=formbuilder

# --- API ---
# Long random string used to sign auth JWTs.
JWT_SECRET=change-me-to-a-long-random-string
# Public origin of the API, used to build absolute file-upload links.
# Use your EC2 public IP or domain, e.g. http://203.0.113.10:4000
PUBLIC_API_URL=http://YOUR_EC2_PUBLIC_IP:4000

# --- Optional: real AI generation (falls back to a heuristic if unset) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Image refs ---
# Normally injected by the Deploy workflow (pinned to the commit SHA).
# Set them here only if you run `docker compose` on the box by hand.
# IMAGE_API=ghcr.io/OWNER/REPO-api:latest
# IMAGE_WEB=ghcr.io/OWNER/REPO-web:latest
# IMAGE_ADMIN=ghcr.io/OWNER/REPO-admin:latest
